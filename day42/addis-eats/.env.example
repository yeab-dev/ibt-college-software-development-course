# Copy to .env.local and replace the value: cp .env.example .env.local
#
# Signs the session cookie (lib/session.js): the HMAC half of every value.
# Server only: no NEXT_PUBLIC_ prefix, so Next.js never puts it in the
# browser's JavaScript. Changing it invalidates every existing session.
# Make a real one with:  openssl rand -base64 32
SESSION_SECRET=replace-me-with-at-least-32-random-characters
