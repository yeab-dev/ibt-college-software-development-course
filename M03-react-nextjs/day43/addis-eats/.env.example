# Copy to .env.local and fill it in:  cp .env.example .env.local
#
# Every variable the application reads is listed here, with a dummy value.
# This file is committed; .env.local, with the real values, never is
# (.gitignore ignores every .env* file except this one).
#
# Day 43: the rule for the prefix. A name starting with NEXT_PUBLIC_ is copied
# into the JavaScript at build time and is readable by anyone who opens the
# page. Anything else exists only on the server. A secret never gets the prefix.

# ---- Server only ------------------------------------------------------------

# Signs the session cookie (lib/session.js): the HMAC half of every value.
# Server only: no NEXT_PUBLIC_ prefix, so Next.js never puts it in the
# browser's JavaScript. Changing it invalidates every existing session.
# Make a real one with:  openssl rand -base64 32
SESSION_SECRET=replace-me-with-at-least-32-random-characters

# ---- Public (inlined into the build) ----------------------------------------

# Optional. An https:// URL of an analytics script, loaded with next/script's
# lazyOnload strategy (components/Analytics.jsx). Empty means no third-party
# script at all, which is how the application ships and how PERF.md was
# measured. Public on purpose: the URL is in every page's HTML anyway.
# Set it before `npm run build`; changing it later needs a rebuild.
NEXT_PUBLIC_ANALYTICS_SRC=
